{
  "name": "life-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "tsc && vite build",
    "vercel-build": "convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd \"pnpm build\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "preview": "vite preview"
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.56",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "convex": "^1.45.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  }
}
