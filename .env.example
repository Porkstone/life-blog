# Local development: `pnpm exec convex dev` writes .env.local automatically.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud

# Vercel Production only (secret; do not add a VITE_ prefix):
# CONVEX_DEPLOY_KEY=<production deploy key>
# VITE_CONVEX_URL is supplied by `pnpm vercel-build` automatically.

# Set these on the Convex deployment, not in the browser or Vercel:
# AUTH_GITHUB_ID=<GitHub OAuth app client ID>
# AUTH_GITHUB_SECRET=<GitHub OAuth app client secret>
# SITE_URL=https://life-blog-five.vercel.app
# JWT_PRIVATE_KEY=<generated RS256 private key>
# JWKS=<generated public key set>
